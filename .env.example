# ─────────────────────────────────────────────────────────────
#  Configuración del bot — copiá este archivo a .env y completá
# ─────────────────────────────────────────────────────────────

# Plataforma a iniciar: telegram | whatsapp | both
PLATFORM=telegram

# Token del bot de Telegram (lo da @BotFather al crear el bot).
# Requerido si PLATFORM=telegram o both.
TELEGRAM_BOT_TOKEN=

# Carpeta donde Baileys guarda la sesión de WhatsApp (multi-device).
# Si la borrás, hay que volver a escanear el QR.
WHATSAPP_AUTH_DIR=./.wa-auth

# Nivel de log: trace | debug | info | warn | error
LOG_LEVEL=info

# ─── IA conversacional (opcional) ───
# API key de Groq (gratis, https://console.groq.com). Si la dejás vacía, los
# mensajes que no sean comandos reciben un "no entendí" en vez de respuesta IA.
GROQ_API_KEY=

# Modelo de Groq a usar.
GROQ_MODEL=llama-3.3-70b-versatile
